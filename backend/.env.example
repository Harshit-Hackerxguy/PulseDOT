# Copy to .env for running the API directly on the host (outside Docker):
#   cp .env.example .env
# docker-compose.yml supplies its own values when running in Docker.
# In production, set these in your host's dashboard (Render, Railway, …) — never commit real values.

# development | production  (production enables stricter config checks + hides error details)
NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:password@localhost:5432/spotify_clone
# TLS for hosted Postgres: leave empty locally / for Render's *internal* URL.
#   true      → TLS with certificate verification (Neon, Supabase, RDS…)
#   no-verify → TLS without verification (self-signed certs)
# Alternatively append ?sslmode=require to DATABASE_URL.
DATABASE_SSL=

# Generate a strong secret (≥ 32 chars, enforced in production): openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash.
# Production example: https://pulse.vercel.app
CLIENT_URL=http://localhost:5173

# Reverse proxies in front of the API (defaults to 1 in production, off in development).
# TRUST_PROXY=1
