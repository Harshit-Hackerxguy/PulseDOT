# Backend origin — no trailing slash, no /api.
#   Local:  http://localhost:5000  (or leave empty to use the Vite dev proxy)
#   Vercel: set in Project → Settings → Environment Variables, e.g. https://pulse-api.onrender.com
# Production builds FAIL if this is missing. It is baked in at build time, so redeploy after changing it.
VITE_API_URL=http://localhost:5000
